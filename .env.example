# Copy to .env and fill strong secrets before running anything
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_PASSWORD=change-me
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_RELAY_PASSWORD=change-me

ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=/stream
STREAM_BITRATE_KBPS=128
STATION_NAME=Radio Free
STATION_DESCRIPTION=Liquidsoap -> Icecast demo stream

# Music locations
MUSIC_ROOT=./music
MUSIC_DIR=/radio/music
S3_MUSIC_BUCKET=
S3_MUSIC_PREFIX=library/
